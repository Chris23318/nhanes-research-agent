DOMAIN=nhanes.example.com
APP_IMAGE=ghcr.io/chris23318/nhanes-research-agent:latest
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Run `node scripts/generate-auth.js`, then copy its generated values here.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true
# Enable only after configuring credentials and restricting access to the deployment.
MODEL_AGENT_ENABLED=false
MODEL_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# SQLite online backups stay inside the private application data volume.
AUTO_BACKUP_ENABLED=true
BACKUP_PATH=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_FILES=30
